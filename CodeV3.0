import tkinter as tk
import time
from datetime import datetime
import keyboard
class App:
    def __init__(self,name="NEW",seg_names=[],**kwargs):

        # control
        self.curseg = 0
        self.seg_names = seg_names
        self.seg_order = segment_order(seg_names)
        self.seg_count = len(seg_names)
        self.best_segs = kwargs.get("best_segs") or []
        self.split_times = kwargs.get("split_times") or []
        self.latest_splits = []
        self.seg_info_cache = get_seg_list_info(self.seg_order,self.curseg+1)


        # timing
        self.main_timer = 0
        self.start = None
        self.seg_timer = 0
        self.stop = None

        # tkinter
        self.w = tk.Tk()
        self.name = name
        self.setup_window()
        self.setup_labels()
        self.setup_hotkeys()
        self.update_loop()

    def setup_window(self):
        self.w.title(self.name)
        self.w.geometry("450x450")
        self.w.configure(bg="black")
        self.w.option_add("*Background", "black")
        self.w.option_add("*Foreground", "white")
        self.w.resizable(False, False)

    def setup_hotkeys(self):
        keyboard.add_hotkey('z', lambda: self.read_instruction("START"))
        keyboard.add_hotkey('x', lambda: self.read_instruction("HELLO!"))
        keyboard.add_hotkey('shift + q', lambda: self.read_instruction("PAUSE"))
        keyboard.add_hotkey('s', lambda: self.read_instruction("SPLIT"))
        keyboard.add_hotkey('shift + s', lambda: self.read_instruction("DESPLIT"))
        keyboard.add_hotkey('ctrl + shift + q', lambda: self.read_instruction("RESET"))


    def setup_labels(self):
        #place timers
        self.main_timer_label = tk.Label(font=("Consolas",25))
        self.seg_timer_label = tk.Label(font=("Consolas",15))
        self.best_seg_label = tk.Label(font=("Consolas",10))
        self.pb_seg_label = tk.Label(font=("Consolas",10))
        self.main_timer_label.place(relx=0.5, rely=0.82,anchor="center")
        self.seg_timer_label.place(relx=0.5, rely=0.9,anchor="center")
        self.best_seg_label.place(relx=0, rely=0.84)
        self.pb_seg_label.place(relx=0, rely=0.9)
        
        #define
        self.seg_backframes = [tk.Frame() for _ in range(11)]
        self.game_name_label = tk.Label(font=("Consolas",15))
        self.left_segment_labels = [tk.Label(font=("Consolas",10) ) for _ in range(11)]
        self.right_segment_labels = [tk.Label(font=("Consolas",10) ) for _ in range(11)]

        #place
        [frame.place(relwidth=1, height=21, y=i*21+80) for  i, frame in enumerate(self.seg_backframes)]
        [label.place(relx=0, y=i*21+90,anchor="w") for i,label in enumerate(self.left_segment_labels)]
        [label.place(relx=1, y=i*21+90,anchor="e") for i,label in enumerate(self.right_segment_labels)]

    def read_instruction(self, cmd):
        match cmd:
            case "START":
                self._start_main_timer()
            case "PAUSE":
                self._pause_main_timer()
            case "RESET":
                self._reset_run()
            case "SPLIT":
                self._split()
            case "DESPLIT":
                self._desplit()


    def main_timer_running(self):
        return self.start is not None and self.stop is None

    def _start_main_timer(self):
        if not self.main_timer_running() and len(self.latest_splits)!=self.seg_count:
            print(f"[{datetime.now().strftime('%H:%M:%S')}] Started main timer.")
            self.stop = None
            self.start = time.time() - self.main_timer

    def _pause_main_timer(self):
        if self.main_timer_running():
            self.stop = time.time()
            if len(self.latest_splits)==self.seg_count:
                print(f"[{datetime.now().strftime('%H:%M:%S')}] 🏁 Finised the run at {formatA(self.main_timer)}.")
            else:
                print(f"[{datetime.now().strftime('%H:%M:%S')}] Paused at {formatA(self.main_timer)}.")

    def _reset_run(self):
        print(f"[{datetime.now().strftime('%H:%M:%S')}] Reset run.")
        self.start = None
        self.stop = None
        self.main_timer = 0.0
        self.latest_splits = []
        self.seg_info_cache = get_seg_list_info(self.seg_order,len(self.latest_splits))


    def _split(self):
        if not self.main_timer_running():
            return False


        self.latest_splits.append(self.main_timer)
        if len(self.latest_splits)==self.seg_count:
            self._pause_main_timer()
        else:
            print(f"[{datetime.now().strftime('%H:%M:%S')}] Splitted into the {ordinal_num(len(self.latest_splits)+1)} overall segment at {formatA(self.main_timer)}.")
        self.seg_info_cache = get_seg_list_info(self.seg_order,len(self.latest_splits))


    def _desplit(self):
        if not self.latest_splits:
           return False
        
        if self.main_timer_running():
            print(f"[{datetime.now().strftime('%H:%M:%S')}] Desplited back into the {ordinal_num(len(self.latest_splits))} segment.")
            self.latest_splits.pop()
            self.seg_info_cache = get_seg_list_info(self.seg_order,len(self.latest_splits))
        elif len(self.latest_splits)==self.seg_count:
            print(f"[{datetime.now().strftime('%H:%M:%S')}] Desplited back into the {ordinal_num(len(self.latest_splits))} segment.")
            self.latest_splits.pop()
            self._start_main_timer()


    def update_loop(self):
        import time

        if self. main_timer_running():
            self.curseg = len(self.latest_splits)

        self.main_timer = ((self.stop or time.time())-self.start) if self.start else self.main_timer
        self.seg_timer  = self.main_timer-(0 if not self.latest_splits else self.latest_splits[-1])



        self.update_labels()
        self.w.after(10,self.update_loop)

    def update_labels(self):

        #timers
        right_fg = "white"   
        curseg = self.curseg
        split_times = self.split_times

        #info
        seg_info = self.seg_info_cache["final_list"]
        seg_repr = seg_list_repr(
            seg_info
            ,compare_to=split_times
            ,split_times=self.latest_splits
            ,best_segs=best_segments
            )

        main_slower_than_pb = self.seg_timer > el_by_ind(split_times,curseg)-el_by_ind(split_times,curseg-1,"restr_neg_ind",default=0)
        if self.main_timer_running():
            right_fg  = (
                "red" if main_slower_than_pb else "#FF8080"
                ) if split_times[curseg] < self.main_timer else (
                "#80FF80" if main_slower_than_pb else "green"
                )
        if len(self.latest_splits)==len(self.split_times):
            right_fg = "red" if self.main_timer > split_times[-1] else "blue"

        self.main_timer_label.configure(
            text=formatA(self.main_timer)
            ,fg=right_fg)
        self.seg_timer_label.configure(text=formatA(self.seg_timer)) 
        
        for i,(left,right,bgframe) in enumerate(
            zip(self.left_segment_labels,self.right_segment_labels,self.seg_backframes)
            ):
            try:
                seg_r = seg_repr[i]
                seg_i = seg_info[i]
            except IndexError:
                left.configure(text="")
                right.configure(text="")
                continue

            bg = "#202020" if i%2 else "#000000"
            if self.curseg in range(seg_i[1][0],seg_i[1][1]+1):
                bg = "#000080" if seg_i[0][0]%2 else "#000060"
            bgframe.configure(bg=bg)
            left.configure(bg=bg)
            right.configure(bg=bg)
            left_text,mid_timer,right_text = seg_r["text"]
            left.configure(text=left_text)
            mid_text = "" if mid_timer is None else f"{mid_timer:+.1f}"
            slower_than_pb = (seg_r["latest"]) and (seg_r["latest"] > seg_r["time"])
            right_fg = "white" if mid_timer is None else "gold" if seg_r["latest"] < seg_r["best"] else (
                (
                    "#80FF80" if slower_than_pb else "green"
                ) if mid_timer < 0 else (
                    "red" if slower_than_pb else "#FF8080"
                )
                )
            right.configure(text=f"{mid_text}   {formatB(right_text)}",fg=right_fg)
        
    
    def run(self):
        self.w.mainloop()
            

app = App("Custom Livesplit v 3.0",
          segment_names,
          split_times=splits["PB"],
          best_times = best_segments
          )
app.run()
  
